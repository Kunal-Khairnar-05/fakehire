# Copy this file to .env and fill in real values. .env is ignored by git; this file is not.

# ---- PostgreSQL (read by the postgres container) ----
POSTGRES_USER=fakehire
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fakehire

# ---- How the API connects (Step 7) ----
# Port 5433 on your laptop -> 5432 inside the container (5432 is taken by your Windows PostgreSQL)
DATABASE_URL=postgresql+psycopg://fakehire:change-me@localhost:5433/fakehire
TEST_DATABASE_URL=postgresql+psycopg://fakehire:change-me@localhost:5433/fakehire_test

# ---- Auth ----
# Generate your own:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-64-random-hex-characters
JWT_EXPIRE_MINUTES=60
