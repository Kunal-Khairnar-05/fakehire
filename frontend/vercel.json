{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://fakehire-api.vercel.app/api/:path*" },
    { "source": "/docs", "destination": "https://fakehire-api.vercel.app/docs" },
    { "source": "/openapi.json", "destination": "https://fakehire-api.vercel.app/openapi.json" },
    { "source": "/health", "destination": "https://fakehire-api.vercel.app/health" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
